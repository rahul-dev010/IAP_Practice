    {
      "name": "fact_sessions",
      "displayName": "fact_sessions",
      "config": {
        "version": "1.1",
        "source": "SELECT f.session_id, f.date_key, f.charger_id, f.station_id, f.member_id, f.status,\n       f.time_band, f.energy_kwh, f.duration_minutes, f.idle_minutes, f.amount_paid,\n       f.member_sk, f.plan_at_session, f.rate_per_kwh, f.energy_charge,\n       f.plan_discount, f.idle_fee, f.billed_amount, f.billing_status, f.fault_count,\n       s.city, to_date(cast(f.date_key AS STRING), 'yyyyMMdd') AS session_date\nFROM vp_rp20040126.gold.fact_sessions f\nJOIN vp_rp20040126.gold.dim_station s ON f.station_id = s.station_id\n",
        "dimensions": [
          {
            "name": "charger_id",
            "expr": "charger_id"
          },
          {
            "name": "station_id",
            "expr": "station_id"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "session_date",
            "expr": "session_date"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "plan_at_session",
            "expr": "plan_at_session"
          },
          {
            "name": "billing_status",
            "expr": "billing_status"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "completed_sessions",
            "expr": "COUNT(CASE WHEN status = 'COMPLETED' THEN 1 END)",
            "displayName": "Completed Sessions"
          },
          {
            "name": "failed_sessions",
            "expr": "COUNT(CASE WHEN status = 'FAILED' THEN 1 END)",
            "displayName": "Failed Sessions"
          },
          {
            "name": "failure_rate_pct",
            "expr": "ROUND(COUNT(CASE WHEN status = 'FAILED' THEN 1 END) * 100.0 / NULLIF(COUNT(CASE WHEN status IN ('COMPLETED', 'FAILED') THEN 1 END), 0), 2)",
            "displayName": "Failure Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "energy_kwh",
            "expr": "SUM(energy_kwh)",
            "displayName": "Energy (kWh)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 3.0
              }
            }
          },
          {
            "name": "total_billed",
            "expr": "SUM(billed_amount)",
            "displayName": "Total Billed",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "revenue_leakage",
            "expr": "SUM(billed_amount - amount_paid)",
            "displayName": "Revenue Leakage",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "success_rate_pct",
            "expr": "ROUND(COUNT(CASE WHEN status = 'COMPLETED' THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2)",
            "displayName": "Success Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
