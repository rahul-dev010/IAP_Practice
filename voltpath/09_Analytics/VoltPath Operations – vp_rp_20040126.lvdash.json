{
  "datasets": [
    {
      "name": "4a134d1b",
      "displayName": "agg_daily_station",
      "config": {
        "version": "1.1",
        "source": "vp_rp20040126.gold.agg_daily_station",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "total_energy_kwh",
            "expr": "SUM(energy_kwh)",
            "displayName": "Total Energy (kWh)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 3.0
              }
            }
          },
          {
            "name": "total_completed",
            "expr": "SUM(completed_sessions)",
            "displayName": "Completed Sessions"
          },
          {
            "name": "total_failed",
            "expr": "SUM(failed_sessions)",
            "displayName": "Failed Sessions"
          },
          {
            "name": "success_rate_pct",
            "expr": "ROUND(SUM(completed_sessions) * 100.0 / NULLIF(SUM(completed_sessions) + SUM(failed_sessions), 0), 2)",
            "displayName": "Success Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "revenue_leakage",
            "expr": "SUM(billed_amount - amount_paid)",
            "displayName": "Revenue Leakage",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_billed",
            "expr": "SUM(billed_amount)",
            "displayName": "Total Billed",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_paid",
            "expr": "SUM(amount_paid)",
            "displayName": "Total Paid",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
