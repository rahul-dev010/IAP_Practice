{
  "datasets": [
    {
      "name": "390b44ac",
      "displayName": "dim_airline",
      "config": {
        "version": "1.1",
        "source": "WITH top5 AS (\n    SELECT f.airline_id\n    FROM tpca.gold.fact_bookings f\n    GROUP BY f.airline_id\n    ORDER BY SUM(f.ticket_price * (1 - f.discount)) DESC\n    LIMIT 5\n) SELECT\n    a.al_airlineid,\n    a.al_name,\n    a.al_nationkey,\n    CASE WHEN a.al_airlineid IN (SELECT airline_id FROM top5)\n         THEN a.al_name\n         ELSE 'REST (other airlines)'\n    END AS airline_group\nFROM tpca.gold.dim_airline a",
        "dimensions": [
          {
            "name": "al_airlineid",
            "expr": "al_airlineid",
            "comment": "Airline key"
          },
          {
            "name": "al_name",
            "expr": "al_name",
            "comment": "Airline name"
          },
          {
            "name": "al_nationkey",
            "expr": "al_nationkey",
            "comment": "Airline home nation key"
          },
          {
            "name": "airline_group",
            "expr": "airline_group",
            "comment": "Top-5 revenue airlines shown individually, all others grouped as REST"
          }
        ]
      }
    },
    {
      "name": "599f9a01",
      "displayName": "dim_geography",
      "config": {
        "version": "1.1",
        "source": "tpca.gold.dim_geography",
        "dimensions": [
          {
            "name": "n_nationkey",
            "expr": "n_nationkey",
            "comment": "Nation key"
          },
          {
            "name": "nation_name",
            "expr": "nation_name",
            "comment": "Nation name"
          },
          {
            "name": "region_name",
            "expr": "region_name",
            "comment": "Region name"
          }
        ]
      }
    },
    {
      "name": "da411ff3",
      "displayName": "dim_passenger",
      "config": {
        "version": "1.1",
        "source": "tpca.gold.dim_passenger",
        "dimensions": [
          {
            "name": "pa_passengerid",
            "expr": "pa_passengerid",
            "comment": "Passenger key"
          },
          {
            "name": "pa_name",
            "expr": "pa_name",
            "comment": "Passenger name"
          },
          {
            "name": "passenger_label",
            "expr": "CONCAT(pa_name, ' (', pa_passengerid, ')')",
            "comment": "Unique passenger display label (name + id, names are not unique)"
          }
        ]
      }
    },
    {
      "name": "2727b538",
      "displayName": "dim_route",
      "config": {
        "version": "1.1",
        "source": "tpca.gold.dim_route",
        "dimensions": [
          {
            "name": "ro_routeid",
            "expr": "ro_routeid",
            "comment": "Route key"
          },
          {
            "name": "ro_name",
            "expr": "ro_name",
            "comment": "Route name (origin-destination)"
          },
          {
            "name": "route_label",
            "expr": "CONCAT(ro_name, ' (', ro_routeid, ')')",
            "comment": "Unique route display label (name + id, names are not unique)"
          }
        ]
      }
    },
    {
      "name": "852c3221",
      "displayName": "fact_bookings",
      "config": {
        "version": "1.1",
        "source": "tpca.gold.fact_bookings",
        "dimensions": [
          {
            "name": "booking_id",
            "expr": "booking_id",
            "comment": "Booking key"
          },
          {
            "name": "passenger_id",
            "expr": "passenger_id",
            "comment": "Passenger foreign key"
          },
          {
            "name": "passenger_nation_key",
            "expr": "passenger_nation_key",
            "comment": "Passenger nation foreign key"
          },
          {
            "name": "route_id",
            "expr": "route_id",
            "comment": "Route foreign key"
          },
          {
            "name": "airline_id",
            "expr": "airline_id",
            "comment": "Airline foreign key"
          },
          {
            "name": "booking_date",
            "expr": "booking_date",
            "comment": "Date the booking was made",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "travel_purpose",
            "expr": "travel_purpose",
            "comment": "Purpose of travel"
          },
          {
            "name": "cabin_class",
            "expr": "cabin_class",
            "comment": "Cabin class booked"
          }
        ],
        "measures": [
          {
            "name": "net_revenue",
            "expr": "SUM(net_amount)",
            "comment": "Net revenue after discount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "distinct_bookings",
            "expr": "COUNT(DISTINCT booking_id)",
            "comment": "Distinct bookings"
          },
          {
            "name": "active_passengers",
            "expr": "COUNT(DISTINCT passenger_id)",
            "comment": "Distinct passengers"
          },
          {
            "name": "avg_booking_value",
            "expr": "SUM(net_amount) / COUNT(DISTINCT booking_id)",
            "comment": "Average net revenue per booking",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(discount)",
            "comment": "Average discount rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_flight_duration_days",
            "expr": "AVG(DATEDIFF(arrival_date, departure_date))",
            "comment": "Average days between departure and arrival",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "dim_airline",
