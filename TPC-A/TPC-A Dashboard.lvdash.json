        },
        {
          "name": "fact_bookings",
          "datasetName": "852c3221"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "fact_bookings",
          "to": "dim_passenger",
          "on": "`fact_bookings`.`passenger_id` = `dim_passenger`.`pa_passengerid`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "fact_bookings",
          "to": "dim_route",
          "on": "`fact_bookings`.`route_id` = `dim_route`.`ro_routeid`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_2",
          "from": "fact_bookings",
          "to": "dim_airline",
          "on": "`fact_bookings`.`airline_id` = `dim_airline`.`al_airlineid`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_3",
          "from": "fact_bookings",
          "to": "dim_geography",
          "on": "`fact_bookings`.`passenger_nation_key` = `dim_geography`.`n_nationkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
